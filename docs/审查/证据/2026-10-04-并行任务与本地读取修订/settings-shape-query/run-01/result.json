{
  "protocol": {
    "sql": {
      "baseline": "WITH current_works AS MATERIALIZED \n(SELECT works.id AS work_id, works.pixiv_illust_id AS pixiv_id, works.default_revision_id AS revision_id, coalesce(work_revisions.type, works.type) AS type, coalesce(work_revisions.page_count, works.page_count) AS page_count \nFROM works LEFT OUTER JOIN work_revisions ON work_revisions.id = works.default_revision_id)\n SELECT coalesce(sum(anon_1.downloaded_pages), ?) AS coalesce_1, coalesce(sum(anon_1.registered_originals), ?) AS coalesce_3, coalesce(sum(anon_1.verified_originals), ?) AS coalesce_5, coalesce(sum(anon_1.unverified_originals), ?) AS coalesce_7, coalesce(sum(CASE WHEN (CASE WHEN (current_works.type = ?) THEN ? ELSE current_works.page_count END - coalesce(anon_1.usable, ?) > ?) THEN CASE WHEN (current_works.type = ?) THEN ? ELSE current_works.page_count END - coalesce(anon_1.usable, ?) ELSE ? END), ?) AS coalesce_9 \nFROM current_works LEFT OUTER JOIN (SELECT assets.work_id AS work_id, sum(CASE WHEN (assets.role = ? AND assets.state = ?) THEN ? ELSE ? END) AS downloaded_pages, sum(CASE WHEN (length(assets.relative_path) > ?) THEN ? ELSE ? END) AS registered_originals, sum(CASE WHEN (assets.state = ?) THEN ? ELSE ? END) AS verified_originals, sum(CASE WHEN (assets.state = ? AND length(assets.relative_path) > ?) THEN ? ELSE ? END) AS unverified_originals, sum(CASE WHEN (length(assets.relative_path) > ? AND (assets.state NOT IN (?, ?, ?, ?, ?))) THEN ? ELSE ? END) AS usable \nFROM assets JOIN (SELECT revision_assets.asset_id AS asset_id \nFROM revision_assets JOIN current_works ON current_works.revision_id = revision_assets.revision_id UNION SELECT assets.id AS asset_id \nFROM assets JOIN current_works ON current_works.work_id = assets.work_id \nWHERE current_works.revision_id IS NULL AND assets.revision_id IS NULL) AS anon_2 ON anon_2.asset_id = assets.id JOIN current_works ON current_works.work_id = assets.work_id \nWHERE current_works.type = ? AND assets.role = ? OR current_works.type != ? AND assets.role = ? AND assets.page_index < current_works.page_count GROUP BY assets.work_id) AS anon_1 ON anon_1.work_id = current_works.work_id \nWHERE (current_works.pixiv_id NOT IN (SELECT archive_intents.pixiv_illust_id \nFROM archive_intents \nWHERE archive_intents.mode = ?))",
      "candidate": "WITH revision_shapes AS MATERIALIZED (SELECT id,type,page_count FROM work_revisions), current_works AS MATERIALIZED \n(SELECT works.id AS work_id, works.pixiv_illust_id AS pixiv_id, works.default_revision_id AS revision_id, coalesce(revision_shapes.type, works.type) AS type, coalesce(revision_shapes.page_count, works.page_count) AS page_count \nFROM works LEFT OUTER JOIN revision_shapes ON revision_shapes.id = works.default_revision_id)\n SELECT coalesce(sum(anon_1.downloaded_pages), ?) AS coalesce_1, coalesce(sum(anon_1.registered_originals), ?) AS coalesce_3, coalesce(sum(anon_1.verified_originals), ?) AS coalesce_5, coalesce(sum(anon_1.unverified_originals), ?) AS coalesce_7, coalesce(sum(CASE WHEN (CASE WHEN (current_works.type = ?) THEN ? ELSE current_works.page_count END - coalesce(anon_1.usable, ?) > ?) THEN CASE WHEN (current_works.type = ?) THEN ? ELSE current_works.page_count END - coalesce(anon_1.usable, ?) ELSE ? END), ?) AS coalesce_9 \nFROM current_works LEFT OUTER JOIN (SELECT assets.work_id AS work_id, sum(CASE WHEN (assets.role = ? AND assets.state = ?) THEN ? ELSE ? END) AS downloaded_pages, sum(CASE WHEN (length(assets.relative_path) > ?) THEN ? ELSE ? END) AS registered_originals, sum(CASE WHEN (assets.state = ?) THEN ? ELSE ? END) AS verified_originals, sum(CASE WHEN (assets.state = ? AND length(assets.relative_path) > ?) THEN ? ELSE ? END) AS unverified_originals, sum(CASE WHEN (length(assets.relative_path) > ? AND (assets.state NOT IN (?, ?, ?, ?, ?))) THEN ? ELSE ? END) AS usable \nFROM assets JOIN (SELECT revision_assets.asset_id AS asset_id \nFROM revision_assets JOIN current_works ON current_works.revision_id = revision_assets.revision_id UNION SELECT assets.id AS asset_id \nFROM assets JOIN current_works ON current_works.work_id = assets.work_id \nWHERE current_works.revision_id IS NULL AND assets.revision_id IS NULL) AS anon_2 ON anon_2.asset_id = assets.id JOIN current_works ON current_works.work_id = assets.work_id \nWHERE current_works.type = ? AND assets.role = ? OR current_works.type != ? AND assets.role = ? AND assets.page_index < current_works.page_count GROUP BY assets.work_id) AS anon_1 ON anon_1.work_id = current_works.work_id \nWHERE (current_works.pixiv_id NOT IN (SELECT archive_intents.pixiv_illust_id \nFROM archive_intents \nWHERE archive_intents.mode = ?))"
