# Public tree: build/runtime inputs only. Local project material stays private.
/*
!/.gitignore
!/README.md
!/LICENSE
!/app/

/app/*
!/app/.env.example
!/app/build.spec
!/app/build_release.py
!/app/release.bat
!/app/requirements.txt
!/app/requirements-lock.txt
!/app/run.py
!/app/start.bat
!/app/start_release.ps1
!/app/stop_release.ps1
!/app/src/
!/app/static/
!/app/frontend/

/app/frontend/*
!/app/frontend/src/
!/app/frontend/index.html
!/app/frontend/package.json
!/app/frontend/package-lock.json
!/app/frontend/tsconfig.json
!/app/frontend/vite.config.ts

# Never publish runtime data, credentials, or generated caches inside source trees.
.env
pixiv_token.json
__pycache__/
*.py[cod]
.pytest_cache/
node_modules/
dist/
*.log
*.db
*.db-wal
*.db-shm
